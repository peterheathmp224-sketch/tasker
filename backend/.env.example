BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE
# Username бота без @ (нужен для кнопки «Войти через Telegram» в браузере).
# Домен из WEBAPP_URL должен быть привязан в BotFather: /setdomain.
BOT_USERNAME=PASTE_YOUR_BOT_USERNAME_HERE
# Секрет для подписи сессий браузерного входа. Можно оставить пустым —
# тогда используется BOT_TOKEN. Лучше задать отдельную случайную строку.
SESSION_SECRET=
DATABASE_URL=postgresql+psycopg2://tasker:tasker@127.0.0.1:5432/tasker
FRONTEND_URL=http://localhost:5173
WEBAPP_URL=https://tasks.immortalhokage.space
DEV_MOCK_USER=true
